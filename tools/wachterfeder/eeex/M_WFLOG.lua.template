-- WACHTERFEDER_EET_COMBAT_LOGGER_V1
-- WACHTERFEDER_EEEX_SAFE_LOGGING_V2
-- WACHTERFEDER_EET_RUNTIME_LOGGER_V3
-- Generated into the local EET override folder by Wächterfeder.
-- Read-only towards game state: this script observes EEex/engine events and
-- emits prefixed lines through the engine-supported logging channel.
--
-- V3 deliberately does NOT use Lua io.*. EEex Minimal / EE Lua may omit the
-- standard io library. C:LogSet + C:LogMessages are the supported Beamdog
-- logging path. A relative filename is intentional: the engine owns the log
-- destination and Wächterfeder reads the resulting local file afterwards.

local WF_LOG_FILE = [[Wachterfeder-runtime.log]]
local WF_PREFIX = "WFLOG|"
local WF_SEQ = 0
local WF_START_HP = {}
local WF_ENGINE_LOG_READY = false

local function wf_escape(value)
    local text = tostring(value or "")
    text = string.gsub(text, "\\", "\\\\")
    text = string.gsub(text, '"', '\\"')
    text = string.gsub(text, "\r", "\\r")
    text = string.gsub(text, "\n", "\\n")
    return text
end

local function wf_number(value, fallback)
    local number = tonumber(value)
    if number == nil then return fallback or -1 end
    return number
end

local function wf_sprite_name(sprite)
    if sprite == nil then return "" end
    local ok, value = pcall(function() return sprite:getName() end)
    if ok and value ~= nil and tostring(value) ~= "" then
        return tostring(value)
    end
    return ""
end

local function wf_sprite_id(sprite)
    if sprite == nil then return -1 end
    local ok, value = pcall(function() return sprite.m_id end)
    if ok then return wf_number(value, -1) end
    return -1
end

local function wf_hp(sprite)
    if sprite == nil then return nil end
    local ok, value = pcall(function() return sprite.m_baseStats.m_hitPoints end)
    if ok then return tonumber(value) end
    return nil
end

local function wf_safe_call(func_name, fallback)
    local func = _G[func_name]
    if type(func) ~= "function" then return fallback end
    local ok, value = pcall(func)
    if ok and value ~= nil then return value end
    return fallback
end

local function wf_prepare_engine_log()
    if WF_ENGINE_LOG_READY then return true end
    local ok = pcall(function()
        if C == nil then error("CLUAConsole unavailable") end
        C:LogSet(WF_LOG_FILE)
        C:LogMessages()
    end)
    WF_ENGINE_LOG_READY = ok
    return ok
end

local function wf_append(line)
    if not wf_prepare_engine_log() then return false end
    return pcall(function()
        local payload = WF_PREFIX .. line
        if type(Infinity_Log) == "function" then
            Infinity_Log(payload)
        else
            print(payload)
        end
    end)
end

local function wf_emit(kind, fields)
    WF_SEQ = WF_SEQ + 1
    local parts = {
        '{"schema_version":3',
        ',"event":"' .. wf_escape(kind) .. '"',
        ',"seq":' .. tostring(WF_SEQ)
    }
    for _, field in ipairs(fields or {}) do
        local key = field[1]
        local value = field[2]
        local value_type = field[3]
        if value_type == "number" then
            table.insert(parts, ',"' .. wf_escape(key) .. '":' .. tostring(wf_number(value, -1)))
        elseif value_type == "boolean" then
            table.insert(parts, ',"' .. wf_escape(key) .. '":' .. (value and "true" or "false"))
        else
            table.insert(parts, ',"' .. wf_escape(key) .. '":"' .. wf_escape(value) .. '"')
        end
    end
    table.insert(parts, "}")
    pcall(function() wf_append(table.concat(parts)) end)
end

-- -------------------------------------------------------------------------
-- Dialogue observation
-- -------------------------------------------------------------------------
-- Infinity_SelectDialogueOption is the engine/UI entry point used when the
-- player selects a dialogue response. We preserve the original function and
-- only record the arguments before delegating to it.
local WF_ORIGINAL_SELECT_DIALOGUE_OPTION = Infinity_SelectDialogueOption
if type(WF_ORIGINAL_SELECT_DIALOGUE_OPTION) == "function" then
    function Infinity_SelectDialogueOption(...)
        local args = {...}
        wf_emit("dialogue_choice", {
            {"arg_count", #args, "number"},
            {"arg1", args[1], "string"},
            {"arg2", args[2], "string"},
            {"arg3", args[3], "string"},
            {"arg4", args[4], "string"},
            {"selected_character", wf_safe_call("Infinity_GetSelectedCharacterName", ""), "string"},
            {"screen", wf_safe_call("Infinity_GetCurrentScreenName", ""), "string"},
            {"game_ticks", wf_safe_call("Infinity_GetGameTicks", -1), "number"}
        })
        return WF_ORIGINAL_SELECT_DIALOGUE_OPTION(...)
    end
else
    wf_emit("logger_error", {
        {"reason", "dialogue_choice_function_unavailable", "string"}
    })
end

-- -------------------------------------------------------------------------
-- Combat observation
-- -------------------------------------------------------------------------
-- EEex's Sprite patch calls these Lua hook names around Opcode #12 damage
-- calculations. Preserve EEex's implementation and add a read-only observer.
local WF_ORIGINAL_DAMAGE_START = EEex_Sprite_Hook_OnDamageEffectStartingCalculations
local WF_ORIGINAL_DAMAGE_DONE = EEex_Sprite_Hook_OnDamageEffectDone

if type(WF_ORIGINAL_DAMAGE_START) == "function" and type(WF_ORIGINAL_DAMAGE_DONE) == "function" then
    function EEex_Sprite_Hook_OnDamageEffectStartingCalculations(effect, sourceSprite, targetSprite)
        local target_id = wf_sprite_id(targetSprite)
        local hp = wf_hp(targetSprite)
        if target_id ~= -1 and hp ~= nil then
            WF_START_HP[target_id] = hp
        end
        return WF_ORIGINAL_DAMAGE_START(effect, sourceSprite, targetSprite)
    end

    function EEex_Sprite_Hook_OnDamageEffectDone(effect, sourceSprite, targetSprite)
        local result = WF_ORIGINAL_DAMAGE_DONE(effect, sourceSprite, targetSprite)
        local target_id = wf_sprite_id(targetSprite)
        local before = WF_START_HP[target_id]
        local after = wf_hp(targetSprite)
        WF_START_HP[target_id] = nil

        if before ~= nil and after ~= nil then
            local damage = before - after
            if damage > 0 then
                wf_emit("damage", {
                    {"source", wf_sprite_name(sourceSprite), "string"},
                    {"source_id", wf_sprite_id(sourceSprite), "number"},
                    {"target", wf_sprite_name(targetSprite), "string"},
                    {"target_id", target_id, "number"},
                    {"damage", damage, "number"},
                    {"hp_before", before, "number"},
                    {"hp_after", after, "number"},
                    {"lethal_candidate", after <= 0, "boolean"},
                    {"game_ticks", wf_safe_call("Infinity_GetGameTicks", -1), "number"}
                })
            end
        end
        return result
    end
else
    wf_emit("logger_error", {
        {"reason", "damage_hooks_unavailable", "string"}
    })
end

-- Heartbeat proves that M_WFLOG.lua was executed and that the runtime channel
-- reached the point at which all observers were registered.
wf_emit("runtime_start", {
    {"logger", "Wachterfeder EET Runtime Logger V3", "string"},
    {"damage_hook", type(WF_ORIGINAL_DAMAGE_DONE) == "function", "boolean"},
    {"dialogue_hook", type(WF_ORIGINAL_SELECT_DIALOGUE_OPTION) == "function", "boolean"},
    {"screen", wf_safe_call("Infinity_GetCurrentScreenName", ""), "string"}
})
